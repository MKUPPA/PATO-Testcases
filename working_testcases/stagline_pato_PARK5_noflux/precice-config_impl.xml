<?xml version="1.0"?>

<precice-configuration>

  <!-- %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% -->
  <log>
    <sink filter="%Severity% > debug and %Rank% = 0"
  	  format="---[precice] %ColorizedSeverity% %Message%"
  	  enabled="true"/>
  </log>
  
  <!-- %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% -->
  <solver-interface dimensions="2">
    <!-- preambule -->

    <!-- aerothermal related variables -->
    <data:scalar name="T"/>
    <data:scalar name="q"/>
    <data:scalar name="p"/>
    <data:vector name="mdot"/>

    <!-- <data:scalar name="radSurf"/> -->

    <!-- ablative air 11 environment species related  -->
    <data:scalar name="y_em"/>
    <data:scalar name="y_N"/>
    <data:scalar name="y_O"/>
    <data:scalar name="y_C"/>
    <data:scalar name="y_N2"/>
    <data:scalar name="y_NO"/>
    <data:scalar name="y_O2"/>
    <data:scalar name="y_CO"/>
    <data:scalar name="y_CO2"/>
    <data:scalar name="y_CN"/>
    <data:scalar name="y_C2"/>
    <data:scalar name="y_C3"/>
    <data:scalar name="y_N2p"/>
    <data:scalar name="y_NOp"/>
    <data:scalar name="y_Np"/>
    <data:scalar name="y_O2p"/>
    <data:scalar name="y_Op"/>
    <data:scalar name="y_COp"/>
    <data:scalar name="y_CNp"/>
    <data:scalar name="y_Cp"/>

    <data:scalar name="flux_em"/>
    <data:scalar name="flux_N"/>
    <data:scalar name="flux_O"/>
    <data:scalar name="flux_C"/>
    <data:scalar name="flux_N2"/>
    <data:scalar name="flux_NO"/>
    <data:scalar name="flux_O2"/>
    <data:scalar name="flux_CO"/>
    <data:scalar name="flux_CO2"/>
    <data:scalar name="flux_CN"/>
    <data:scalar name="flux_C2"/>
    <data:scalar name="flux_C3"/>
    <data:scalar name="flux_N2p"/>
    <data:scalar name="flux_NOp"/>
    <data:scalar name="flux_Np"/>
    <data:scalar name="flux_O2p"/>
    <data:scalar name="flux_Op"/>
    <data:scalar name="flux_COp"/>
    <data:scalar name="flux_CNp"/>
    <data:scalar name="flux_Cp"/>

    <!-- PATO ablation relative species -->
    <!-- <data:scalar name="rhoUeCh"/> -->

    <!-- %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% -->
    
    <!-- surface mesh -->
    <mesh name="hegel_wall">
      <!-- aerothermal related variables -->
      <use-data name="T"/>
      <use-data name="q"/>
      <use-data name="mdot"/>
      <use-data name="p"/>

      <!-- ablative air 11 environment species related  -->
      <use-data name="y_em"/>
      <use-data name="y_N"/>
      <use-data name="y_O"/>
      <use-data name="y_C"/>
      <use-data name="y_N2"/>
      <use-data name="y_NO"/>
      <use-data name="y_O2"/>
      <use-data name="y_CO"/>
      <use-data name="y_CO2"/>
      <use-data name="y_CN"/>
      <use-data name="y_C2"/>
      <use-data name="y_C3"/>
      <use-data name="y_N2p"/>
      <use-data name="y_NOp"/>
      <use-data name="y_Np"/>
      <use-data name="y_O2p"/>
      <use-data name="y_Op"/>
      <use-data name="y_COp"/>
      <use-data name="y_CNp"/>
      <use-data name="y_Cp"/>

      <use-data name="flux_em"/>
      <use-data name="flux_N"/>
      <use-data name="flux_O"/>
      <use-data name="flux_C"/>
      <use-data name="flux_N2"/>
      <use-data name="flux_NO"/>
      <use-data name="flux_O2"/>
      <use-data name="flux_CO"/>
      <use-data name="flux_CO2"/>
      <use-data name="flux_CN"/>
      <use-data name="flux_C2"/>
      <use-data name="flux_C3"/>
      <use-data name="flux_N2p"/>
      <use-data name="flux_NOp"/>
      <use-data name="flux_Np"/>
      <use-data name="flux_O2p"/>
      <use-data name="flux_Op"/>
      <use-data name="flux_COp"/>
      <use-data name="flux_CNp"/>
      <use-data name="flux_Cp"/>
    </mesh>

    <mesh name="SolidMesh">
      <!-- aerothermal related variables -->
      <use-data name="T"/>
      <use-data name="q"/>
      <use-data name="mdot"/>
      <use-data name="p"/>

      <!-- ablative air 11 environment species related  -->
      <use-data name="y_em"/>
      <use-data name="y_N"/>
      <use-data name="y_O"/>
      <use-data name="y_C"/>
      <use-data name="y_N2"/>
      <use-data name="y_NO"/>
      <use-data name="y_O2"/>
      <use-data name="y_CO"/>
      <use-data name="y_CO2"/>
      <use-data name="y_CN"/>
      <use-data name="y_C2"/>
      <use-data name="y_C3"/>
      <use-data name="y_N2p"/>
      <use-data name="y_NOp"/>
      <use-data name="y_Np"/>
      <use-data name="y_O2p"/>
      <use-data name="y_Op"/>
      <use-data name="y_COp"/>
      <use-data name="y_CNp"/>
      <use-data name="y_Cp"/>

      <use-data name="flux_em"/>
      <use-data name="flux_N"/>
      <use-data name="flux_O"/>
      <use-data name="flux_C"/>
      <use-data name="flux_N2"/>
      <use-data name="flux_NO"/>
      <use-data name="flux_O2"/>
      <use-data name="flux_CO"/>
      <use-data name="flux_CO2"/>
      <use-data name="flux_CN"/>
      <use-data name="flux_C2"/>
      <use-data name="flux_C3"/>
      <use-data name="flux_N2p"/>
      <use-data name="flux_NOp"/>
      <use-data name="flux_Np"/>
      <use-data name="flux_O2p"/>
      <use-data name="flux_Op"/>
      <use-data name="flux_COp"/>
      <use-data name="flux_CNp"/>
      <use-data name="flux_Cp"/>

      <!-- PATO ablation relative species -->
      <!-- <use-data  name="rhoUeCh"/> -->
    </mesh>

    <!-- %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% -->
    <!-- HEGEL mesh -->
    <participant name="HEGEL">
      <!-- Hegel surface mesh -->
      <use-mesh   name="hegel_wall"    provide="yes"/>
      <use-mesh   name="SolidMesh"   from="SolidSolver"/>
      <!-- aerothermal related variables -->
      <read-data  name="T"         mesh="hegel_wall"/>
      <write-data name="q"         mesh="hegel_wall"/>
      <write-data name="p"         mesh="hegel_wall"/>
      <read-data  name="mdot"      mesh="hegel_wall"/>

      <!-- ablative air 11 environment species related  -->
      <read-data  name="y_em"      mesh="hegel_wall"/>
      <read-data  name="y_N"       mesh="hegel_wall"/>
      <read-data  name="y_O"       mesh="hegel_wall"/>
      <read-data  name="y_C"       mesh="hegel_wall"/>
      <read-data  name="y_N2"      mesh="hegel_wall"/>
      <read-data  name="y_NO"      mesh="hegel_wall"/>
      <read-data  name="y_O2"      mesh="hegel_wall"/>
      <read-data  name="y_CO"      mesh="hegel_wall"/>
      <read-data  name="y_CO2"     mesh="hegel_wall"/>
      <read-data  name="y_CN"      mesh="hegel_wall"/>
      <read-data  name="y_C2"      mesh="hegel_wall"/>
      <read-data  name="y_C3"      mesh="hegel_wall"/>
      <read-data  name="y_N2p"     mesh="hegel_wall"/>
      <read-data  name="y_NOp"     mesh="hegel_wall"/>
      <read-data  name="y_Np"      mesh="hegel_wall"/>
      <read-data  name="y_O2p"     mesh="hegel_wall"/>
      <read-data  name="y_Op"      mesh="hegel_wall"/>
      <read-data  name="y_COp"     mesh="hegel_wall"/>
      <read-data  name="y_CNp"     mesh="hegel_wall"/>
      <read-data  name="y_Cp"      mesh="hegel_wall"/>

      <write-data name="flux_em"   mesh="hegel_wall"/>
      <write-data name="flux_N"    mesh="hegel_wall"/>
      <write-data name="flux_O"    mesh="hegel_wall"/>
      <write-data name="flux_C"    mesh="hegel_wall"/>
      <write-data name="flux_N2"   mesh="hegel_wall"/>
      <write-data name="flux_NO"   mesh="hegel_wall"/>
      <write-data name="flux_O2"   mesh="hegel_wall"/>
      <write-data name="flux_CO"   mesh="hegel_wall"/>
      <write-data name="flux_CO2"  mesh="hegel_wall"/>
      <write-data name="flux_CN"   mesh="hegel_wall"/>
      <write-data name="flux_C2"   mesh="hegel_wall"/>
      <write-data name="flux_C3"   mesh="hegel_wall"/>
      <write-data name="flux_N2p"  mesh="hegel_wall"/>
      <write-data name="flux_NOp"  mesh="hegel_wall"/>
      <write-data name="flux_Np"   mesh="hegel_wall"/>
      <write-data name="flux_O2p"  mesh="hegel_wall"/>
      <write-data name="flux_Op"   mesh="hegel_wall"/>
      <write-data name="flux_COp"  mesh="hegel_wall"/>
      <write-data name="flux_CNp"  mesh="hegel_wall"/>
      <write-data name="flux_Cp"   mesh="hegel_wall"/>
      <mapping:nearest-neighbor direction="read" from="SolidMesh"
                                to="hegel_wall" constraint="consistent"/>

    </participant>

    <!-- Pato mesh -->
    <participant name="SolidSolver">
      <use-mesh  name="SolidMesh"       provide="yes"/>
      <use-mesh  name="hegel_wall"        from="HEGEL"/>
      <!-- aerothermal related variables -->
      <write-data name="T"         mesh="SolidMesh"/>
      <read-data  name="q"         mesh="SolidMesh"/>
      <read-data  name="p"         mesh="SolidMesh"/>
      <write-data name="mdot"      mesh="SolidMesh"/>

      <write-data name="y_em"      mesh="SolidMesh"/>
      <write-data name="y_N"       mesh="SolidMesh"/>
      <write-data name="y_O"       mesh="SolidMesh"/>
      <write-data name="y_C"       mesh="SolidMesh"/>
      <write-data name="y_N2"      mesh="SolidMesh"/>
      <write-data name="y_NO"      mesh="SolidMesh"/>
      <write-data name="y_O2"      mesh="SolidMesh"/>
      <write-data name="y_CO"      mesh="SolidMesh"/>
      <write-data name="y_CO2"     mesh="SolidMesh"/>
      <write-data name="y_CN"      mesh="SolidMesh"/>
      <write-data name="y_C2"      mesh="SolidMesh"/>
      <write-data name="y_C3"      mesh="SolidMesh"/>
      <write-data name="y_N2p"     mesh="SolidMesh"/>
      <write-data name="y_NOp"     mesh="SolidMesh"/>
      <write-data name="y_Np"      mesh="SolidMesh"/>
      <write-data name="y_O2p"     mesh="SolidMesh"/>
      <write-data name="y_Op"      mesh="SolidMesh"/>
      <write-data name="y_COp"     mesh="SolidMesh"/>
      <write-data name="y_CNp"     mesh="SolidMesh"/>
      <write-data name="y_Cp"      mesh="SolidMesh"/>

      <read-data  name="flux_em"   mesh="SolidMesh"/>
      <read-data  name="flux_N"    mesh="SolidMesh"/>
      <read-data  name="flux_O"    mesh="SolidMesh"/>
      <read-data  name="flux_C"    mesh="SolidMesh"/>
      <read-data  name="flux_N2"   mesh="SolidMesh"/>
      <read-data  name="flux_NO"   mesh="SolidMesh"/>
      <read-data  name="flux_O2"   mesh="SolidMesh"/>
      <read-data  name="flux_CO"   mesh="SolidMesh"/>
      <read-data  name="flux_CO2"  mesh="SolidMesh"/>
      <read-data  name="flux_CN"   mesh="SolidMesh"/>
      <read-data  name="flux_C2"   mesh="SolidMesh"/>
      <read-data  name="flux_C3"   mesh="SolidMesh"/>
      <read-data  name="flux_N2p"  mesh="SolidMesh"/>
      <read-data  name="flux_NOp"  mesh="SolidMesh"/>
      <read-data  name="flux_Np"   mesh="SolidMesh"/>
      <read-data  name="flux_O2p"  mesh="SolidMesh"/>
      <read-data  name="flux_Op"   mesh="SolidMesh"/>
      <read-data  name="flux_COp"  mesh="SolidMesh"/>
      <read-data  name="flux_CNp"  mesh="SolidMesh"/>
      <read-data  name="flux_Cp"   mesh="SolidMesh"/>
      <!-- PATO ablation relative species -->
      <!-- <read-data  name="rhoUeCh"   mesh="SolidMeshFace"/> -->

      <watch-integral mesh="SolidMesh" name="pato-integral" scale-with-connectivity="true"/>
      <!-- CORRECT THE STAGNATION POINT LOCATION CORRESPONDING TO THE GEOMETRY INVESTIGATED -->
      <watch-point    mesh="SolidMesh" name="stagnation-point" coordinate="0.4; 0"/>

      <mapping:nearest-neighbor direction="read" from="hegel_wall"
                                to="SolidMesh" constraint="consistent"/>
      
    </participant>
    
    <!-- %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% -->

      <m2n:sockets from="HEGEL" to="SolidSolver" />	    
	
    <!-- %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% -->
    <!-- BEST COUPLING SCHEME FOR HEGEL-PATO SURFACE COUPLING IS AITKEN IMPLICIT SERIAL -->
    <!-- Surface coupling configuration -->
    <coupling-scheme:serial-implicit>
      <participants first="SolidSolver" second="HEGEL"/>
      <time-window-size valid-digits="10" method="fixed"  value="1e-8"/>
      <max-time value="1e-6"/>

      <!-- Face data -->
      <!-- aerothermal related variables -->
      <exchange data="T"         mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="q"         mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="1" />
      <exchange data="p"         mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="1" />
      <exchange data="mdot"      mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0" />

      <!-- ablative air 11 environment species related  -->
      <exchange data="y_em" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_N" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_O" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_C" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_N2" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_NO" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_O2" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_CO" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_CO2" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_CN" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_C2" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_C3" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_N2p" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_NOp" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_Np" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_O2p" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_Op" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_COp" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_CNp" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="y_Cp" mesh="SolidMesh"
		from="SolidSolver" to="HEGEL" initialize="0"/>
      <exchange data="flux_em" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_N" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_O" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_C" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_N2" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_NO" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_O2" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_CO" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_CO2" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_CN" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_C2" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_C3" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_N2p" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_NOp" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_Np" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_O2p" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_Op" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_COp" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_CNp" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>
      <exchange data="flux_Cp" mesh="hegel_wall"
		from="HEGEL" to="SolidSolver" initialize="0"/>

      <!-- Parameters for IMPLICIT coupling scheme -->
      <max-iterations value="50"/>
      <extrapolation-order value="2"/>

      <!-- I request convergence of driving physics data, i.e. heat flux -->
      <absolute-convergence-measure limit="1.e-02" data="q"
                                    mesh="hegel_wall"  strict="0" suffices="1"/>
      <relative-convergence-measure limit="1.e-04" data="q"
                                    mesh="hegel_wall"  strict="0" suffices="1"/>
      <residual-relative-convergence-measure limit="1.e-02" data="q"
                                    mesh="hegel_wall"  strict="0" suffices="1"/>
      <absolute-convergence-measure limit="1.e-02" data="p"
                                    mesh="hegel_wall"  strict="0" suffices="0"/>
      <absolute-convergence-measure limit="1.e-02" data="flux_CO"
                                    mesh="hegel_wall"  strict="0" suffices="0"/>

      <acceleration:aitken>
      <initial-relaxation value="0.01"/>
      <data name="q" mesh="hegel_wall"/>
      </acceleration:aitken>
	

    </coupling-scheme:serial-implicit>
  </solver-interface>

</precice-configuration>
