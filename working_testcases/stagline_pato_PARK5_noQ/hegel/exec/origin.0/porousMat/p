FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 287; 

boundaryField
{
  outer
    {
      type   fixedValue;    // since p from hegel
      value  $internalField;
    }
  back
    {
      type   zeroGradient;
    }
  inner
    {
      type   fixedGradient;
      gradient uniform 0;
    }
  axis
    {
      type   empty;
    }
  wedge-left
    {
      type   wedge;
    }
  wedge-right
    {
      type   wedge;
    }
}


